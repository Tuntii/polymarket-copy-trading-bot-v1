# ===========================================
# POLYMARKET COPY TRADING BOT - CONFIGURATION
# ===========================================

# ----- WALLET CONFIGURATION -----
# Target wallet address to copy trades from
USER_ADDRESS=0x...

# Your Polymarket proxy wallet address
PROXY_WALLET=0x...

# Your wallet private key (KEEP THIS SECRET!)
PRIVATE_KEY=your_private_key_here

# ----- API CONFIGURATION -----
# Polymarket CLOB API endpoints
CLOB_HTTP_URL=https://clob.polymarket.com/
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws

# Polygon RPC URL (get from Infura, Alchemy, etc.)
RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_API_KEY

# USDC Contract Address on Polygon
USDC_CONTRACT_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# ----- DATABASE -----
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/polymarket_copytrading

# ----- GENERAL SETTINGS -----
# How often to fetch target user's trades (in seconds)
FETCH_INTERVAL=1

# Skip trades older than this (in hours)
TOO_OLD_TIMESTAMP=1

# How many times to retry a failed trade
RETRY_LIMIT=3

# ===========================================
# RISK MANAGEMENT SETTINGS
# ===========================================

# ----- POSITION LIMITS -----
# Maximum amount for a single position (in USDC)
MAX_POSITION_SIZE_USDC=100

# Maximum total open positions value (in USDC)
MAX_TOTAL_EXPOSURE_USDC=500

# Minimum trade amount (in USDC)
MIN_TRADE_AMOUNT_USDC=1

# ----- LOSS LIMITS -----
# Maximum daily loss allowed (in USDC)
MAX_DAILY_LOSS_USDC=50

# Maximum daily loss as percentage of balance
MAX_DAILY_LOSS_PERCENT=10

# Stop-loss percentage (per position)
STOP_LOSS_PERCENT=20

# ----- PROFIT TARGETS -----
# Take-profit percentage (per position)
TAKE_PROFIT_PERCENT=50

# ----- SLIPPAGE & PRICE PROTECTION -----
# Maximum slippage tolerance (percentage)
MAX_SLIPPAGE_PERCENT=2

# Skip trade if price changed more than this (percentage)
MAX_PRICE_DIFFERENCE_PERCENT=5

# Skip trade if price changed too much since original (percentage)
SKIP_IF_PRICE_CHANGED_PERCENT=10

# ----- TRADE FREQUENCY -----
# Minimum time between trades (in milliseconds)
MIN_TIME_BETWEEN_TRADES_MS=5000

# Maximum trades per hour
MAX_TRADES_PER_HOUR=20

# Maximum trades per day
MAX_TRADES_PER_DAY=100

# ----- BALANCE PROTECTION -----
# Minimum balance to always keep in account (in USDC)
MIN_BALANCE_TO_KEEP_USDC=10

# Maximum percentage of balance to use for trading
MAX_BALANCE_USAGE_PERCENT=80

# ----- COPY TRADING SPECIFIC -----
# What percentage of target user's trade to copy (100 = same amount)
COPY_RATIO_PERCENT=100
